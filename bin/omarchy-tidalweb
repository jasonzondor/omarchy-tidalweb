#!/bin/bash
# omarchy:summary=Launch / toggle / hide the TIDAL web player drop-down for the shell plugin
# omarchy:args=[toggle|show|hide|launch|stop|status]
#
# The audio engine for the com.zondor.tidalweb plugin: an ordinary Chromium
# running the TIDAL web player in its own profile. It lives on the special:tidal
# workspace and drops down when you click the bar widget. There is no DevTools
# port and nothing headless — closing this window stops the music, so the widget
# toggles it rather than closing it.

set -euo pipefail

URL="https://listen.tidal.com"
WINDOW_CLASS="com.zondor.tidalweb"
SPECIAL_WS="tidal"
PANEL_W=980
PANEL_H=700

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-tidalweb"
PROFILE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-tidalweb/chromium"
mkdir -p "$RUNTIME_DIR" "$(dirname "$PROFILE_DIR")"

resolve_chromium() {
  local desktop exec_bin
  desktop="$(xdg-settings get default-web-browser 2>/dev/null || true)"
  case "$desktop" in
    chromium.desktop | google-chrome.desktop | brave-browser.desktop | \
      brave-origin.desktop | microsoft-edge.desktop | vivaldi-stable.desktop | helium.desktop)
      exec_bin="$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
        {"$HOME"/.local,"$HOME"/.nix-profile,/usr}/share/applications/"$desktop" \
        2>/dev/null | head -1)"
      ;;
  esac
  if [[ -n "${exec_bin:-}" ]] && command -v "$exec_bin" >/dev/null 2>&1; then
    printf '%s\n' "$exec_bin"; return 0
  fi
  local c
  for c in chromium chromium-browser google-chrome-stable google-chrome brave brave-browser vivaldi-stable microsoft-edge; do
    command -v "$c" >/dev/null 2>&1 && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

is_running() { pgrep -f -- "--user-data-dir=$PROFILE_DIR" >/dev/null 2>&1; }

window_address() {
  hyprctl clients -j 2>/dev/null |
    jq -r --arg c "$WINDOW_CLASS" '.[] | select(.class == $c) | .address' | head -1
}

special_active() {
  hyprctl monitors -j 2>/dev/null |
    jq -e --arg w "special:$SPECIAL_WS" 'any(.[]; .specialWorkspace.name == $w)' >/dev/null 2>&1
}

# Park the window on special:tidal, floating and sized like a panel. Best effort:
# an `o.window` rule (see `omarchy-tidalweb-setup hypr`) does this more cleanly,
# but the plugin should still work without one.
stow_window() {
  local addr i
  for i in $(seq 1 60); do
    addr="$(window_address)"; [[ -n "$addr" ]] && break
    sleep 0.1
  done
  [[ -z "$addr" ]] && return 1

  local mon_w scale x
  read -r mon_w scale < <(hyprctl monitors -j 2>/dev/null |
    jq -r 'map(select(.focused))[0] // .[0] | "\(.width) \(.scale)"')
  x=$(awk -v w="${mon_w:-1920}" -v s="${scale:-1}" -v p="$PANEL_W" 'BEGIN{printf "%d", (w/s - p)/2}')

  hyprctl --batch "\
dispatch movetoworkspacesilent special:$SPECIAL_WS,address:$addr ; \
dispatch setfloating address:$addr ; \
dispatch resizewindowpixel exact $PANEL_W $PANEL_H,address:$addr ; \
dispatch movewindowpixel exact ${x:-200} 56,address:$addr" >/dev/null 2>&1 || true
}

launch() {
  is_running && { stow_window; return 0; }
  local chromium
  if ! chromium="$(resolve_chromium)"; then
    command -v omarchy-notification-send >/dev/null 2>&1 &&
      omarchy-notification-send "TIDAL Web needs a Chromium-family browser installed"
    echo "omarchy-tidalweb: no Chromium-family browser found" >&2
    exit 1
  fi
  setsid -f "$chromium" \
    --app="$URL" \
    --user-data-dir="$PROFILE_DIR" \
    --class="$WINDOW_CLASS" \
    --no-first-run \
    --no-default-browser-check \
    >/dev/null 2>&1
  stow_window
}

show() {
  launch
  special_active || hyprctl dispatch togglespecialworkspace "$SPECIAL_WS" >/dev/null 2>&1 || true
}

hide() {
  special_active && hyprctl dispatch togglespecialworkspace "$SPECIAL_WS" >/dev/null 2>&1 || true
}

toggle() {
  if is_running && special_active; then hide; else show; fi
}

stop() {
  pkill -f -- "--user-data-dir=$PROFILE_DIR" 2>/dev/null || true
}

status() {
  local running=false visible=false
  is_running && running=true
  special_active && visible=true
  printf '{"running":%s,"visible":%s,"profile":"%s"}\n' "$running" "$visible" "$PROFILE_DIR"
}

case "${1:-toggle}" in
  toggle) toggle ;;
  show) show ;;
  hide) hide ;;
  launch) launch ;;
  stop) stop ;;
  status) status ;;
  *) echo "usage: omarchy-tidalweb [toggle|show|hide|launch|stop|status]" >&2; exit 2 ;;
esac
