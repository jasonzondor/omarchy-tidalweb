#!/bin/bash
# omarchy:summary=Run / show / hide the isolated Chromium that plays TIDAL for the shell plugin
# omarchy:args=[show|hide|toggle|launch|stop|status|port]
#
# The audio engine for the quickshell.tidalweb plugin. This is an ordinary
# Chromium running the TIDAL web player, kept in its own profile so its login
# is isolated and its DevTools port is safe to open. It parks its own window
# (class "omarchy-tidalweb") on the special:tidal workspace with
# movetoworkspacesilent, so no Hyprland window rule is needed.
#
# It deliberately does not speak the DevTools protocol itself — the plugin's
# Python bridge does that. This script only manages the process and the window.

set -euo pipefail

URL="https://listen.tidal.com"
WINDOW_CLASS="omarchy-tidalweb"
SPECIAL_WS="tidal"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-tidalweb"
PROFILE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-tidalweb/chromium"
PORT_FILE="$RUNTIME_DIR/cdp-port"
DEFAULT_PORT=9222

mkdir -p "$RUNTIME_DIR" "$(dirname "$PROFILE_DIR")"

# --- browser resolution ------------------------------------------------------
# A Chromium-family engine is required (Widevine for playback, CDP for the
# bridge). Prefer whatever Chromium binary the default browser's .desktop
# points at; fall back to the first Chromium-ish binary on PATH.
resolve_chromium() {
  local desktop exec_bin
  desktop="$(xdg-settings get default-web-browser 2>/dev/null || true)"
  case "$desktop" in
    chromium.desktop | google-chrome.desktop | brave-browser.desktop | \
      brave-origin.desktop | microsoft-edge.desktop | vivaldi-stable.desktop | \
      helium.desktop)
      exec_bin="$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
        {"$HOME"/.local,"$HOME"/.nix-profile,/usr}/share/applications/"$desktop" \
        2>/dev/null | head -1)"
      ;;
  esac
  if [[ -n "${exec_bin:-}" ]] && command -v "$exec_bin" >/dev/null 2>&1; then
    printf '%s\n' "$exec_bin"
    return 0
  fi
  local c
  for c in chromium chromium-browser google-chrome-stable google-chrome \
    brave brave-browser vivaldi-stable microsoft-edge; do
    if command -v "$c" >/dev/null 2>&1; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

port_free() {
  # Returns 0 when nothing is listening on 127.0.0.1:$1.
  ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

pick_port() {
  local p=$DEFAULT_PORT
  while ! port_free "$p"; do
    p=$((p + 1))
    ((p > DEFAULT_PORT + 40)) && {
      echo "omarchy-tidalweb: no free CDP port near $DEFAULT_PORT" >&2
      exit 1
    }
  done
  printf '%s\n' "$p"
}

current_port() {
  [[ -r "$PORT_FILE" ]] && cat "$PORT_FILE" || printf '%s\n' "$DEFAULT_PORT"
}

is_running() {
  pgrep -f -- "--user-data-dir=$PROFILE_DIR" >/dev/null 2>&1
}

cdp_up() {
  curl -sf -m 2 "http://127.0.0.1:$(current_port)/json/version" >/dev/null 2>&1
}

window_address() {
  hyprctl clients -j 2>/dev/null |
    jq -r --arg c "$WINDOW_CLASS" '.[] | select(.class == $c) | .address' | head -1
}

special_active() {
  hyprctl monitors -j 2>/dev/null |
    jq -e --arg w "special:$SPECIAL_WS" 'any(.[]; .specialWorkspace.name == $w)' >/dev/null 2>&1
}

on_special() {
  local addr
  addr="$(window_address)"
  [[ -z "$addr" ]] && return 1
  hyprctl clients -j 2>/dev/null |
    jq -e --arg a "$addr" --arg w "special:$SPECIAL_WS" \
      'any(.[]; .address == $a and .workspace.name == $w)' >/dev/null 2>&1
}

# Park the window on the special workspace ourselves, so the plugin needs no
# Hyprland window rule. `movetoworkspacesilent` does not steal focus.
stow_window() {
  local addr
  for _ in $(seq 1 50); do
    addr="$(window_address)"
    [[ -n "$addr" ]] && break
    sleep 0.1
  done
  [[ -z "$addr" ]] && return 1
  on_special && return 0
  hyprctl dispatch movetoworkspacesilent "special:$SPECIAL_WS,address:$addr" >/dev/null 2>&1 || true
}

launch() {
  is_running && return 0
  local chromium port
  if ! chromium="$(resolve_chromium)"; then
    command -v omarchy-notification-send >/dev/null 2>&1 &&
      omarchy-notification-send "TIDAL Web needs a Chromium-family browser installed"
    echo "omarchy-tidalweb: no Chromium-family browser found" >&2
    exit 1
  fi
  port="$(pick_port)"
  printf '%s\n' "$port" >"$PORT_FILE"

  # setsid + uwsm-app matches how Omarchy launches its own web apps, so the
  # process is scoped correctly and outlives this script.
  # No --remote-allow-origins: the Python bridge connects with a raw socket and
  # sends no Origin header, which Chromium's DevTools endpoint accepts. Leaving
  # the flag off means no web origin can reach the port even if it finds it.
  setsid -f "$chromium" \
    --app="$URL" \
    --user-data-dir="$PROFILE_DIR" \
    --class="$WINDOW_CLASS" \
    --remote-debugging-port="$port" \
    --remote-debugging-address=127.0.0.1 \
    --no-first-run \
    --no-default-browser-check \
    --no-service-autorun \
    >/dev/null 2>&1

  stow_window
}

show() {
  local was_running=1
  is_running || was_running=0
  launch
  [[ "$was_running" -eq 1 ]] && stow_window
  special_active || hyprctl dispatch togglespecialworkspace "$SPECIAL_WS" >/dev/null 2>&1 || true
}

hide() {
  special_active && hyprctl dispatch togglespecialworkspace "$SPECIAL_WS" >/dev/null 2>&1 || true
}

toggle() {
  if special_active; then hide; else show; fi
}

stop() {
  pkill -f -- "--user-data-dir=$PROFILE_DIR" 2>/dev/null || true
  rm -f "$PORT_FILE"
}

status() {
  local running=false up=false
  is_running && running=true
  cdp_up && up=true
  printf '{"running":%s,"cdp":%s,"port":%s,"profile":"%s"}\n' \
    "$running" "$up" "$(current_port)" "$PROFILE_DIR"
}

case "${1:-launch}" in
  launch) launch ;;
  show) show ;;
  hide) hide ;;
  toggle) toggle ;;
  stop) stop ;;
  status) status ;;
  port) current_port ;;
  *)
    echo "usage: omarchy-tidalweb [launch|show|hide|toggle|stop|status|port]" >&2
    exit 2
    ;;
esac
