#!/bin/bash
# omarchy:summary=Set up / diagnose the com.zondor.tidalweb plugin
# omarchy:args=[check|hypr|bindings|desktop|uninstall] [--purge]
#
#   check      report what is and is not ready
#   hypr       print the recommended Hyprland window rule for the drop-down
#   bindings   print a suggested ~/.config/hypr/bindings.lua line
#   desktop    add "TIDAL Web" to the app launcher
#   uninstall  remove the desktop entry (and, with --purge, the Chromium profile)

set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_DIR="$(dirname "$HERE")"

DESKTOP_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/applications/omarchy-tidalweb.desktop"
ICON_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps/omarchy-tidalweb.svg"
PROFILE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-tidalweb"

PURGE=0
for a in "$@"; do [[ "$a" == "--purge" ]] && PURGE=1; done

red() { printf '\033[31m✗\033[0m %s\n' "$*"; }
grn() { printf '\033[32m✓\033[0m %s\n' "$*"; }
ylw() { printf '\033[33m!\033[0m %s\n' "$*"; }

chromium_family() {
  case "$(xdg-settings get default-web-browser 2>/dev/null || true)" in
    chromium.desktop | google-chrome.desktop | brave-browser.desktop | \
      brave-origin.desktop | microsoft-edge.desktop | vivaldi-stable.desktop | helium.desktop)
      return 0 ;;
  esac
  return 1
}

cmd_check() {
  if chromium_family; then
    grn "default browser is Chromium-family ($(xdg-settings get default-web-browser))"
  elif command -v chromium >/dev/null 2>&1; then
    ylw "default browser is not Chromium-family; the plugin will use 'chromium' directly"
  else
    red "no Chromium-family browser found — install one (e.g. 'omarchy pkg add chromium')"
  fi

  for tool in jq hyprctl; do
    command -v "$tool" >/dev/null 2>&1 && grn "$tool present" || red "$tool missing"
  done

  local cdm="$HOME/.config/chromium/WidevineCdm $HOME/.config/google-chrome/WidevineCdm $PROFILE_DIR/chromium/WidevineCdm"
  if compgen -G "$HOME/.config/*/WidevineCdm" >/dev/null 2>&1 || compgen -G "$PROFILE_DIR/chromium/WidevineCdm" >/dev/null 2>&1; then
    grn "Widevine CDM present (needed for lossless playback)"
  else
    ylw "no Widevine CDM found yet — Chromium downloads it on first DRM playback"
  fi

  if [[ "$PLUGIN_DIR" == "$HOME/.config/omarchy/plugins/"* ]]; then
    grn "plugin installed under ~/.config/omarchy/plugins"
  else
    ylw "plugin dir: $PLUGIN_DIR — install with 'omarchy plugin add <git-url>'"
  fi

  if hyprctl -j getoption 2>/dev/null >/dev/null; then :; fi
  if grep -rqs 'com\.zondor\.tidalweb' "$HOME/.config/hypr/" 2>/dev/null; then
    grn "Hyprland window rule in place"
  else
    ylw "no Hyprland window rule — run '$0 hypr' for a tidier drop-down (optional)"
  fi

  local status; status="$("$HERE/omarchy-tidalweb" status 2>/dev/null || echo '{}')"
  if [[ "$(jq -r '.running // false' <<<"$status" 2>/dev/null)" == "true" ]]; then
    grn "TIDAL window is running"
  else
    ylw "TIDAL window not running — click the bar widget (or 'omarchy-shell tidalweb show') and sign in"
  fi

  printf '\nNext: "%s bindings", then click the widget and sign in to TIDAL.\n' "$0"
}

cmd_hypr() {
  cat <<'EOF'
Optional but recommended — makes the drop-down a tidy floating panel instead of
a full-screen window. Add to ~/.config/hypr/hyprland.lua, below the line
"Add any other personal Hyprland configuration below":

  o.window("com.zondor.tidalweb", {
    float = true,
    size = "980 700",
    center = true,
    workspace = "special:tidal",
  })

Then apply and check:  hyprctl reload && hyprctl configerrors
EOF
}

cmd_bindings() {
  cat <<'EOF'
Omarchy does not bind a plugin's surfaces. Add to ~/.config/hypr/bindings.lua
(pick a free combo — check first with `omarchy menu keybindings --print`):

  o.bind("SUPER + ALT + T", "TIDAL", "omarchy-shell tidalweb toggle")

Media keys (play/pause, next, prev) already work through MPRIS.
EOF
}

cmd_desktop() {
  mkdir -p "$(dirname "$DESKTOP_FILE")" "$(dirname "$ICON_FILE")"
  [[ -f "$PLUGIN_DIR/assets/icon.svg" ]] && cp "$PLUGIN_DIR/assets/icon.svg" "$ICON_FILE"
  cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=TIDAL Web
Comment=TIDAL for the Omarchy shell
Exec=$PLUGIN_DIR/bin/omarchy-tidalweb show
Icon=omarchy-tidalweb
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupWMClass=com.zondor.tidalweb
EOF
  command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$(dirname "$DESKTOP_FILE")" >/dev/null 2>&1 || true
  grn "installed $DESKTOP_FILE"
}

cmd_uninstall() {
  rm -f "$DESKTOP_FILE" "$ICON_FILE" && grn "removed desktop entry"
  "$HERE/omarchy-tidalweb" stop 2>/dev/null || true
  if [[ "$PURGE" -eq 1 ]]; then
    rm -rf "$PROFILE_DIR" && grn "removed Chromium profile + TIDAL login ($PROFILE_DIR)"
  else
    ylw "kept the Chromium profile; pass --purge to delete it and the TIDAL login"
  fi
}

case "${1:-check}" in
  check) cmd_check ;;
  hypr) cmd_hypr ;;
  bindings) cmd_bindings ;;
  desktop) cmd_desktop ;;
  uninstall) cmd_uninstall ;;
  *)
    echo "usage: omarchy-tidalweb-setup [check|hypr|bindings|desktop|uninstall] [--purge]" >&2
    exit 2
    ;;
esac
