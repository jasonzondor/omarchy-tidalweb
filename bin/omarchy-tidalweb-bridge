#!/usr/bin/python3
"""Chrome DevTools Protocol bridge for the quickshell.tidalweb plugin.

Stdlib only — runs on the /usr/bin/python3 every Omarchy box already has, no
pip. It connects to the isolated Chromium that `omarchy-tidalweb` launches,
injects bin/omt-inject.js, and relays a newline-delimited JSON protocol:

  stdin  (commands):  {"cmd":"navigate","url":"..."}  {"cmd":"next"}  {"cmd":"lyrics"}
  stdout (events):    {"ev":"ready"}  {"ev":"lyrics",...}  {"ev":"queue",...}  {"ev":"disconnected"}

The plugin's Service.qml runs this as a long-lived child process and restarts
it if it exits. It is also usable by hand for debugging:

  echo '{"cmd":"lyrics"}' | bin/omarchy-tidalweb-bridge
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import select
import socket
import sys
import time
import urllib.request

GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_INJECT = os.path.join(HERE, "omt-inject.js")


def runtime_port() -> int:
    for arg in sys.argv[1:]:
        if arg.startswith("--port="):
            return int(arg.split("=", 1)[1])
    path = os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "omarchy-tidalweb", "cdp-port"
    )
    try:
        with open(path) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return 9222


def inject_source() -> str:
    for arg in sys.argv[1:]:
        if arg.startswith("--inject="):
            return open(arg.split("=", 1)[1]).read()
    return open(DEFAULT_INJECT).read()


def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


# --------------------------------------------------------------------------- ws


class WebSocket:
    """The smallest RFC 6455 client that can carry CDP over loopback."""

    def __init__(self, url: str):
        _, _, rest = url.partition("://")
        hostport, _, path = rest.partition("/")
        host, _, port = hostport.partition(":")
        self.sock = socket.create_connection((host, int(port or 80)), timeout=5)
        key = base64.b64encode(os.urandom(16)).decode()
        req = (
            f"GET /{path} HTTP/1.1\r\n"
            f"Host: {hostport}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        )
        self.sock.sendall(req.encode())
        resp = b""
        while b"\r\n\r\n" not in resp:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("handshake closed")
            resp += chunk
        if b" 101 " not in resp.split(b"\r\n", 1)[0]:
            raise ConnectionError(f"handshake rejected: {resp.splitlines()[0]!r}")
        accept = base64.b64encode(hashlib.sha1((key + GUID).encode()).digest()).decode()
        if accept.encode() not in resp:
            raise ConnectionError("bad Sec-WebSocket-Accept")
        self.sock.setblocking(False)
        self.buf = bytearray(resp.split(b"\r\n\r\n", 1)[1])
        self._frag = bytearray()

    def fileno(self) -> int:
        return self.sock.fileno()

    def send_text(self, text: str) -> None:
        payload = text.encode()
        header = bytearray([0x81])  # FIN + text
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += n.to_bytes(2, "big")
        else:
            header.append(0x80 | 127)
            header += n.to_bytes(8, "big")
        mask = os.urandom(4)
        header += mask
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes(header) + masked)

    def _pong(self, payload: bytes) -> None:
        header = bytearray([0x8A])
        header.append(0x80 | len(payload))
        mask = os.urandom(4)
        header += mask
        self.sock.sendall(
            bytes(header) + bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        )

    def recv_messages(self) -> list[str]:
        """Drain the socket and return any complete text messages."""
        try:
            while True:
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise ConnectionError("peer closed")
                self.buf += chunk
        except BlockingIOError:
            pass

        out: list[str] = []
        while True:
            frame = self._take_frame()
            if frame is None:
                return out
            fin, opcode, payload = frame
            if opcode == 0x8:  # close
                raise ConnectionError("close frame")
            if opcode == 0x9:  # ping
                self._pong(payload)
                continue
            if opcode == 0xA:  # pong
                continue
            if opcode in (0x0, 0x1, 0x2):
                self._frag += payload
                if fin:
                    try:
                        out.append(self._frag.decode("utf-8", "replace"))
                    finally:
                        self._frag = bytearray()

    def _take_frame(self):
        b = self.buf
        if len(b) < 2:
            return None
        b1, b2 = b[0], b[1]
        fin = bool(b1 & 0x80)
        opcode = b1 & 0x0F
        masked = bool(b2 & 0x80)
        length = b2 & 0x7F
        idx = 2
        if length == 126:
            if len(b) < 4:
                return None
            length = int.from_bytes(b[2:4], "big")
            idx = 4
        elif length == 127:
            if len(b) < 10:
                return None
            length = int.from_bytes(b[2:10], "big")
            idx = 10
        if masked:
            idx += 4
        if len(b) < idx + length:
            return None
        if masked:
            mask = b[idx - 4 : idx]
            payload = bytes(x ^ mask[i % 4] for i, x in enumerate(b[idx : idx + length]))
        else:
            payload = bytes(b[idx : idx + length])
        del b[: idx + length]
        return fin, opcode, payload

    def close(self) -> None:
        try:
            self.sock.close()
        except OSError:
            pass


# -------------------------------------------------------------------------- cdp


class Session:
    def __init__(self, port: int, inject: str):
        self.port = port
        self.inject = inject
        self.ws: WebSocket | None = None
        self._id = 0

    def _target_ws_url(self) -> str:
        raw = urllib.request.urlopen(
            f"http://127.0.0.1:{self.port}/json/list", timeout=3
        ).read()
        targets = json.loads(raw)
        pages = [t for t in targets if t.get("type") == "page"]
        for t in pages:
            if "tidal." in (t.get("url") or ""):
                return t["webSocketDebuggerUrl"]
        if pages:
            return pages[0]["webSocketDebuggerUrl"]
        raise ConnectionError("no page target")

    def call(self, method: str, params: dict | None = None) -> None:
        self._id += 1
        self.ws.send_text(json.dumps({"id": self._id, "method": method, "params": params or {}}))

    def evaluate(self, expression: str) -> None:
        self.call("Runtime.evaluate", {"expression": expression, "awaitPromise": False})

    def setup(self) -> None:
        self.call("Page.enable")
        self.call("Runtime.enable")
        self.call("Page.setLifecycleEventsEnabled", {"enabled": True})
        self.call("Runtime.addBinding", {"name": "__omtSend"})
        self.call("Page.addScriptToEvaluateOnNewDocument", {"source": self.inject})
        self.evaluate(self.inject)
        emit({"ev": "ready", "port": self.port})

    def handle_cdp(self, msg: dict) -> None:
        method = msg.get("method")
        if method == "Runtime.bindingCalled" and msg["params"].get("name") == "__omtSend":
            try:
                emit(json.loads(msg["params"]["payload"]))
            except (ValueError, KeyError):
                pass
        elif method in ("Runtime.executionContextsCleared", "Page.frameNavigated"):
            # SPA soft-navs and full loads both land here; re-running the inject
            # is cheap and idempotent (it guards on window.__omt).
            self.evaluate(self.inject)

    def handle_command(self, line: str) -> None:
        try:
            cmd = json.loads(line)
        except ValueError:
            return
        name = cmd.get("cmd")
        if name == "navigate" and cmd.get("url"):
            self.call("Page.navigate", {"url": str(cmd["url"])})
        elif name == "raise":
            self.call("Page.bringToFront")
        elif name in ("next", "prev", "playpause", "favorite"):
            self.evaluate(f"window.__omt && window.__omt.{name}()")
        elif name == "queuePlay":
            self.evaluate(f"window.__omt && window.__omt.queuePlay({int(cmd.get('index', 0))})")
        elif name in ("lyrics", "queue", "quality", "nowplaying", "rescan"):
            self.evaluate("window.__omt && window.__omt.rescan()")
        elif name == "ping":
            emit({"ev": "pong"})

    def run(self) -> None:
        self.ws = WebSocket(self._target_ws_url())
        self.setup()
        stdin = sys.stdin
        while True:
            rlist, _, _ = select.select([self.ws, stdin], [], [], 30)
            if not rlist:
                self.call("Runtime.evaluate", {"expression": "1"})  # keepalive
                continue
            if self.ws in rlist:
                for raw in self.ws.recv_messages():
                    try:
                        self.handle_cdp(json.loads(raw))
                    except ValueError:
                        pass
            if stdin in rlist:
                line = stdin.readline()
                if line == "":
                    return  # stdin closed — parent is gone
                line = line.strip()
                if line:
                    self.handle_command(line)


def main() -> int:
    inject = inject_source()
    backoff = 1.0
    while True:
        port = runtime_port()
        try:
            Session(port, inject).run()
            return 0  # clean stdin EOF
        except KeyboardInterrupt:
            return 0
        except (OSError, ConnectionError, ValueError) as exc:
            emit({"ev": "disconnected", "error": str(exc)})
            time.sleep(backoff)
            backoff = min(backoff * 1.7, 15.0)


if __name__ == "__main__":
    sys.exit(main())
